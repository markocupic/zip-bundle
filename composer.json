{
    "name": "markocupic/zip-bundle",
    "description": "Provides a simple ZIP extension for zipping directories recursively.",
    "keywords": [
        "contao",
        "zip",
        "zip recursive"
    ],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/zip-bundle/issues",
        "source": "https://github.com/markocupic/zip-bundle"
    },
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "contao/core-bundle": "^5.3 || ^6.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/mime": "^6.4 || ^7.0 || ^8.0",
        "symfony/string": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "contao/test-case": "^5.3 || ^6.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\ZipBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\ZipBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\ZipBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "contao-community-alliance/composer-plugin": true
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-8j6w-3kr7-s9xk",
                    "PKSA-6j95-1jtb-x6wc",
                    "PKSA-cbx2-m9db-bmzd"
                ]
            }
        }
    },
    "scripts": {
        "cs-fixer": "@php .ecs/vendor/bin/ecs check --config .ecs/config/default.php --fix --ansi",
        "cs-check": "@php .ecs/vendor/bin/ecs check --config .ecs/config/default.php --ansi",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
